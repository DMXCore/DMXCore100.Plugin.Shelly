<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Local feed for unpublished DMXCore.PluginSdk versions during
         development: pack the SDK from the Software repo with a package
         version HIGHER than the latest on nuget.org (package versions run
         ahead of the contract's AssemblyVersion), e.g.
         dotnet pack src/PluginSdk -p:Version=1.3.0 -o D:\Projects\DMXCore\LocalNuGet
         The folder is optional — restore falls through to nuget.org. -->
    <add key="local" value="D:\Projects\DMXCore\LocalNuGet" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
