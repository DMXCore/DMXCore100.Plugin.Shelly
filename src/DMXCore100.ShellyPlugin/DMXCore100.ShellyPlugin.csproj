<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- The SDK generates manifest.json and PluginBuildInfo from these -->
    <PluginId>shelly</PluginId>
    <PluginDisplayName>Shelly</PluginDisplayName>
    <Version>1.2.1</Version>
    <Authors>DMX Core</Authors>

    <!-- Plugin registry (nuget.org) package metadata. DMXCore.Plugin.* is the
         reserved first-party prefix; the package is produced by `dotnet pack`
         via the DMXCore.PluginSdk pack targets. -->
    <PackageId>DMXCore.Plugin.Shelly</PackageId>
    <Description>Shelly output for the DMX Core 100 lighting controller: drives Shelly Gen1 color devices (RGBW2 and similar) from DMX channel data over MQTT.</Description>
    <PackageProjectUrl>https://docs.dmxcore.com/dmx-core-100</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Embedded icon (not iconUrl) is a nuget.org reserved-prefix review
         criterion; icon.png is the same 128x128 logo the SDK packages ship. -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>shelly;mqtt;smart-lighting</PackageTags>
    <!-- Floor: oldest SDK contract this plugin actually requires. Without
         this override the floor would default to the contract of the SDK
         assembly we compile against, which is newer than we need. -->
    <PluginMinSdkVersion>1.3</PluginMinSdkVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- ExcludeAssets="runtime": the DMX Core 100 host provides the SDK (and
         its dependencies) at runtime and always resolves them to its own
         copies, so they must not be shipped inside the .dmxplugin. -->
    <PackageReference Include="DMXCore.PluginSdk" Version="1.*" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
